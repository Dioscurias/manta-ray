{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.manta.bet" }],
      "destination": "https://manta.bet/:path*",
      "permanent": true
    },
    {
      "source": "/play",
      "destination": "/projects/speedster/play",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/projects", "destination": "/projects.html" },
    { "source": "/projects/speedster/play", "destination": "/projects/speedster/play.html" },
    { "source": "/projects/:slug", "destination": "/projects/:slug.html" }
  ]
}
